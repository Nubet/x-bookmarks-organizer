{
  "private": true,
  "name": "x-bookmarks-organizer",
  "author": "Norbert Fila",
  "description": "Search, organize, and manage X bookmarks with folders, filters, sorting, and bulk actions.",
  "version": "1.0.1",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "dexie": "4.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "extension": "^4.1.25",
    "oxlint": "1.83.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  },
  "scripts": {
    "build:page": "tsc -p tsconfig.page.json",
    "dev": "npm run build:page && extension dev",
    "start": "npm run build:page && extension start",
    "build": "npm run build:page && extension build",
    "preview": "extension preview",
    "build:chrome": "npm run build:page && extension build --browser chrome",
    "build:firefox": "npm run build:page && extension build --browser firefox",
    "build:edge": "npm run build:page && extension build --browser edge",
    "lint": "oxlint src tests benchmarks",
    "doctor": "npx react-doctor@latest --verbose",
    "doctor:diff": "npx react-doctor@latest --verbose --scope changed",
    "test": "vitest run",
    "benchmark:search": "vitest bench benchmarks/search-bookmarks.bench.ts"
  },
  "packageManager": "npm@11.13.0"
}
